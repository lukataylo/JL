# Stripe test mode ONLY (sk_test_...). Leave blank to run in local simulation mode.
STRIPE_SECRET_KEY=
# From `stripe listen --forward-to localhost:4242/webhooks/stripe`
STRIPE_WEBHOOK_SECRET=
ISSUING_CURRENCY=gbp

# Claude agent for flagged (borderline) payments. Leave blank to escalate all flags.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
# Stripe gives ~2s to answer issuing_authorization.request; the agent gets this slice of it.
AGENT_DEADLINE_MS=1500
# Card taps backed by a PaymentIntent hold have no 2s limit.
AGENT_HOLD_DEADLINE_MS=10000

PORT=4242
