# Stripe test mode ONLY (sk_test_...). Leave blank to run in local simulation mode.
STRIPE_SECRET_KEY=
# From `stripe listen --forward-to localhost:4242/webhooks/stripe`
STRIPE_WEBHOOK_SECRET=
ISSUING_CURRENCY=gbp

# Claude agent for flagged (borderline) payments. Leave blank to escalate all flags.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
# Conversational turns (funds requests, negotiation). Defaults to CLAUDE_MODEL.
CLAUDE_CHAT_MODEL=
# After this, the scripted fallback answers so the demo never stalls.
CLAUDE_CHAT_TIMEOUT_MS=12000

PORT=4242
